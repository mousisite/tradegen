# The bundled runtime is rebuilt by setup.bat and is far too large to commit.
.runtime/

# Everything personal: the journal, the accumulated strategy record, and the
# key that signs session cookies all live here.
data/
# Except the tests' own files, which are nobody's: Apple's signed test data.
!tests/data/
*.db
*.db-wal
*.db-shm
secret.key

# Credentials. .env.example is committed on purpose; .env never is.
.env
.env.*
!.env.example

# Keys downloaded from Apple and others, and what editors and the Mac leave.
*.p8
*.pem
.claude/
.impeccable/
.DS_Store

# Notes for whoever runs this copy. They are not for a public repository.
/docs/

# Local settings, so a public repo does not carry your account size around.
config.json

_clipboard.png
*.json.out
__pycache__/
*.pyc
backups/
