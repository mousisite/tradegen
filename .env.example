# Optional. Without it the bot still runs: pass --symbol instead of a
# screenshot, and headline scoring falls back to the built-in finance lexicon.
#
# With it you get:
#   - screenshot reading (ticker, timeframe, visible price)
#   - materially better news sentiment on tricky financial phrasing
#
# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
STOCKBOT_ACCOUNT_SIZE=10000
STOCKBOT_RISK_PCT=1.0

# ---------------------------------------------------------------------------
# Optional: Google sign-in
#
# Leave these unset to run on your own machine. With no credentials there is no
# login at all: the app opens straight into your own data.
#
# Set them only when putting this somewhere other people can reach, because
# then every visitor needs an account and each person's journal, watchlist,
# alerts and theses are visible only to them.
#
# To get them:
#   1. console.cloud.google.com -> create a project
#   2. APIs & Services -> OAuth consent screen -> External -> fill in the name
#      and support email. Scopes: email, profile, openid.
#   3. Credentials -> Create credentials -> OAuth client ID -> Web application
#   4. Authorised redirect URIs: add the callback address EXACTLY, including
#      the port and the scheme. For local testing that is
#      http://localhost:8000/auth/google/callback
#      For a deployed copy it is https://your-domain/auth/google/callback
#   5. Copy the client ID and secret into the two lines below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if the address the app sees differs from the one the browser
# used, which happens behind a proxy. Must match the OAuth client exactly.
GOOGLE_REDIRECT_URI=

# Restrict sign-in to one or more email domains, comma separated. Empty means
# anyone with a Google account may sign in, which is right for a public product
# and wrong for an internal one.
GOOGLE_ALLOWED_DOMAINS=

# Signs the session cookie. Generated and kept in data/secret.key if unset,
# which is fine for one machine. Set it explicitly when running more than one
# copy, or they will not accept each other's sessions.
STOCKBOT_SECRET_KEY=
